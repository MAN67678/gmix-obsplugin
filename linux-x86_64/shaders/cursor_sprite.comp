#version 450 core
#extension GL_EXT_scalar_block_layout : enable

// ─────────────────────────────────────────────────────────────────────────────
// GMix cursor sprite — renders a sharp cursor at a smoothed position.
// 
// This pass runs LAST and draws a cursor sprite on top of the blended frame.
// The cursor position is the latest (newest) cursor position from the path,
// optionally interpolated for sub-frame smoothness.
// ─────────────────────────────────────────────────────────────────────────────

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) readonly  uniform image2D srcImage;  // blended frame (with trail)
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D dstImage; // final output

layout(push_constant) uniform PC {
    uint  frameW;
    uint  frameH;
    float cursorX;       // window-normalized [0,1] cursor position (latest)
    float cursorY;
    float cursorSize;    // cursor radius in pixels
    float cursorAlpha;   // cursor opacity (0..1)
    uint  cursorStyle;   // 0 = circle, 1 = crosshair, 2 = dot
    float aspectRatio;   // frameW / frameH for circular cursor
    float cursorFade;    // fade factor (1.0 = visible, 0.0 = faded out)
} pc;

vec4 loadSrc(ivec2 p, ivec2 sz) {
    return imageLoad(srcImage, clamp(p, ivec2(0), sz - ivec2(1)));
}

float sdCircle(vec2 p, float r) {
    return length(p) - r;
}

float sdCrosshair(vec2 p, float r, float thickness) {
    // Crosshair: two perpendicular lines
    float h = abs(p.x) - r;
    float v = abs(p.y) - r;
    float d = max(min(h, v), 0.0) + min(max(h, v), 0.0);
    return d - thickness * 0.5;
}

float sdDot(vec2 p, float r) {
    return length(p) - r;
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.frameW || gid.y >= pc.frameH) return;

    ivec2 sz = ivec2(pc.frameW, pc.frameH);
    ivec2 P  = ivec2(gid);
    vec4 base = loadSrc(P, sz);

    // Cursor position in pixel coordinates
    vec2 cursorPos = vec2(pc.cursorX * pc.frameW, pc.cursorY * pc.frameH);
    vec2 fp = vec2(P) + 0.5;
    vec2 delta = fp - cursorPos;

    // Correct for aspect ratio to keep cursor circular
    delta.x *= pc.aspectRatio;

    float dist = length(delta);
    float cursorRadius = pc.cursorSize;
    float alpha = 0.0;

    if (pc.cursorStyle == 0u) {
        // Circle cursor (outline + fill)
        float outlineThickness = 2.0;
        float fillRadius = cursorRadius - outlineThickness;
        if (dist <= cursorRadius) {
            if (dist <= fillRadius) {
                alpha = 1.0;  // fill
            } else {
                alpha = smoothstep(cursorRadius, fillRadius, dist);  // outline
            }
        }
    } else if (pc.cursorStyle == 1u) {
        // Crosshair
        float thickness = 2.0;
        float d = sdCrosshair(delta, cursorRadius, thickness);
        if (d <= 0.0) {
            alpha = 1.0 - abs(d) / thickness;
        }
    } else {
        // Simple dot
        if (dist <= cursorRadius) {
            alpha = 1.0 - smoothstep(0.0, cursorRadius, dist);
        }
    }

    alpha *= pc.cursorAlpha;
    alpha *= pc.cursorFade;  // apply release fade

    if (alpha > 0.0) {
        // White cursor with subtle glow
        vec3 cursorColor = vec3(1.0, 1.0, 1.0);
        // Add slight glow at edges
        if (pc.cursorStyle == 0u && dist > cursorRadius - 2.0 && dist <= cursorRadius) {
            cursorColor = vec3(1.0, 1.0, 1.0) * (1.0 + (cursorRadius - dist) * 0.5);
        }
        base.rgb = mix(base.rgb, cursorColor, alpha);
        base.a = 1.0;
    }

    imageStore(dstImage, P, base);
}