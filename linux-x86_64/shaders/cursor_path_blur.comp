#version 450 core
#extension GL_EXT_scalar_block_layout : enable

// ─────────────────────────────────────────────────────────────────────────────
// GMix cursor-path motion blur — LOCALIZED cursor trail only.
// 
// Applies a directional streak ONLY within `blurWidth` of the cursor's true
// path through the shutter window. Outside that radius: pure passthrough of
// the pass-1 (optical flow) result — no mixing, no falloff, no bloom here.
// 
// The streak is ADDITIVE: it adds a brightened trail on top of the optical-
// flow-blended frame, simulating a glowing cursor motion trail.
// ─────────────────────────────────────────────────────────────────────────────

#define MAX_PTS 64   // must match kMaxBlendFrames

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) readonly  uniform image2D blendSrc; // pass-1 result (optical flow)
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D dstImage; // final output

// Cursor path in blend-buffer pixels, newest first, pointCount entries valid.
layout(std430, set = 0, binding = 2) readonly buffer Path {
    vec2 pts[MAX_PTS];
} path;

layout(push_constant) uniform PC {
    uint  frameW;
    uint  frameH;
    uint  pointCount;    // valid entries in path.pts (0..MAX_PTS)
    float blurWidth;     // half-thickness of the streak in px (~cursor radius)
    float blurStrength;  // streak intensity (0..3, >1 = glow boost)
    float trailFade;     // extra fade px beyond blurWidth for smoother edge
    float trailFadeIn;   // fade-in factor (0..1, CPU computes from trailFadeInTime)
    float bboxMinX;      // cursor-tube bounding box (path extent + margin)
    float bboxMinY;      // pixels outside it skip ALL path math
    float bboxMaxX;
    float bboxMaxY;
} pc;

vec4 loadClamped(ivec2 p, ivec2 sz) {
    return imageLoad(blendSrc, clamp(p, ivec2(0), sz - ivec2(1)));
}

float luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

void main()
{
    uvec2 gid = gl_GlobalInvocationID.xy;
    if (gid.x >= pc.frameW || gid.y >= pc.frameH) return;

    ivec2 sz = ivec2(pc.frameW, pc.frameH);
    ivec2 P  = ivec2(gid);
    vec4  base = loadClamped(P, sz);  // pass-1 optical flow result

    // Feature off / nothing to trace: pure passthrough.
    if (pc.pointCount < 2u || pc.blurWidth <= 0.0f || pc.blurStrength <= 0.0f) {
        imageStore(dstImage, P, base);
        return;
    }

    vec2 fp = vec2(P) + 0.5f;

    // Outside the path bounding box: pure passthrough (early exit).
    if (fp.x < pc.bboxMinX || fp.x > pc.bboxMaxX ||
        fp.y < pc.bboxMinY || fp.y > pc.bboxMaxY) {
        imageStore(dstImage, P, base);
        return;
    }

    // ── Find perpendicular distance to full path polyline ──
    float bestDist = 1e9f;
    float totalPathLen = 0.0f;

    // Total path length
    for (uint i = 0u; i + 1u < pc.pointCount; ++i) {
        totalPathLen += length(path.pts[i + 1u] - path.pts[i]);
    }

    // Nearest point on path polyline
    float accumulatedLen = 0.0f;
    for (uint i = 0u; i + 1u < pc.pointCount; ++i) {
        vec2 a = path.pts[i];
        vec2 b = path.pts[i + 1u];
        vec2 ab = b - a;
        float len2 = dot(ab, ab);
        if (len2 < 1e-6f) continue;
        float t = clamp(dot(fp - a, ab) / len2, 0.0f, 1.0f);
        vec2 proj = a + t * ab;
        float d = distance(fp, proj);
        if (d < bestDist) bestDist = d;
        accumulatedLen += length(ab);
    }

    // Head cap (extend slightly beyond first point)
    if (pc.pointCount >= 2u) {
        vec2 hd = path.pts[0] - path.pts[1];
        float hl = length(hd);
        if (hl > 1e-3f) {
            vec2 dir = hd / hl;
            vec2 a = path.pts[0];
            vec2 b = a + dir * clamp(hl * 4.0f, 0.0f, pc.blurWidth);
            vec2 ab = b - a;
            float len2 = dot(ab, ab);
            if (len2 > 1e-6f) {
                float t = clamp(dot(fp - a, ab) / len2, 0.0f, 1.0f);
                float d = distance(fp, a + t * ab);
                if (d < bestDist) bestDist = d;
            }
        }
    }

    // HARD CUTOFF at blurWidth + trailFade: outside = pure passthrough.
    float maxDist = pc.blurWidth + pc.trailFade;
    if (bestDist > maxDist) {
        imageStore(dstImage, P, base);
        return;
    }

    // ── Inside cursor trail: ADDITIVE streak over optical flow base ──
    // Weight by perpendicular distance with smooth falloff.
    float perpWeight;
    if (bestDist <= pc.blurWidth) {
        // Full strength within blurWidth
        perpWeight = 1.0f - (bestDist / pc.blurWidth);
        perpWeight *= perpWeight;  // quadratic for softer core
    } else {
        // Fade out in trailFade region beyond blurWidth
        float fadeT = (bestDist - pc.blurWidth) / pc.trailFade;
        perpWeight = (1.0f - fadeT) * (1.0f - fadeT);  // quadratic fade
    }

    // Sample the base color at the nearest path point (cursor position).
    // This creates a streak that follows the cursor's exact sampled positions.
    vec3 streakColor = vec3(0.0f);
    float streakWeight = 0.0f;

    for (uint i = 0u; i < pc.pointCount; ++i) {
        vec2 samplePos = path.pts[i];
        float d = distance(fp, samplePos);
        if (d > pc.blurWidth) continue;  // only nearby path points contribute
        float w = 1.0f - d / pc.blurWidth;
        w *= w;
        streakColor += loadClamped(P + ivec2(round(samplePos - fp)), sz).rgb * w;
        streakWeight += w;
    }

    vec3 streak = (streakWeight > 0.0f) ? (streakColor / streakWeight) : base.rgb;

    // Additive blend: base + streak * strength
    // blurStrength 0..1: subtle trail. >1: glow boost (additive).
    float strength = clamp(pc.blurStrength, 0.0f, 3.0f);
    
    // Apply fade-in factor (CPU computes from trailFadeInTime)
    strength *= pc.trailFadeIn;

    vec3 result = base.rgb + streak * perpWeight * strength;

    // Clamp to prevent over-brightening static areas
    result = min(result, vec3(1.0f));

    imageStore(dstImage, P, vec4(result, 1.0f));
}